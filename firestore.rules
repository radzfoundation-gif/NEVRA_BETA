rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Custom token from Clerk's "firebase" JWT template sets uid === Clerk userId.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Per-user data: users/{uid}/** ────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);

        match /{subCollection}/{subDocId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ── Public catalog: read-only seeds (glassTools, skills, styles, ...) ─
    match /catalog/{catalogId} {
      allow read: if true;
      allow write: if false;

      match /items/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Public chat shares: read only when isShared===true ───────────────
    match /shares/{shareId} {
      allow read: if resource.data.isShared == true;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
