# UseGlass AI environment example
# Copy this file to `.env.local` for local development.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# Local runtime
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8788
API_PROXY_URL=http://localhost:8788
VITE_API_BASE_URL=/api
VITE_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Turso / libSQL (primary database)
# -----------------------------------------------------------------------------
# Production Turso database:
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_database_token

# Local fallback. Used when TURSO_DATABASE_URL is empty.
TURSO_LOCAL_URL=file:./useglass-turso.db

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Main server-side provider used by builder/chat flows.
SUMOPOD_API_KEY=your_sumopod_api_key
SUMOPOD_BASE_URL=https://ai.sumopod.com
SUMOPOD_MODEL_ID=gpt-5-mini
SUMOPOD_REDESIGN_MODEL_ID=gemini/gemini-3-pro-preview

# Optional OpenRouter fallback/pro models.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=UseGlass AI

# Optional OpenAI-compatible bridge exposed at /v1/chat/completions.
OPENCLAW_API_KEY=your_internal_openclaw_key

# Optional frontend-only research helper currently referenced by ResearchWelcome.
VITE_SUMOPOD_API_KEY=your_sumopod_api_key_for_browser_if_needed
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_if_needed
VITE_GEMINI_API_KEY=your_gemini_key_if_needed
VITE_GROQ_API_KEY=your_groq_key_if_needed
GEMINI_API_KEY=your_gemini_key_if_needed

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_key
MIDTRANS_IS_PRODUCTION=false

# Optional Stripe legacy vars if you keep old payment paths.
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -----------------------------------------------------------------------------
# Email / notifications
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=UseGlass AI <noreply@useglass.ai>

# -----------------------------------------------------------------------------
# Collaboration / realtime editor
# -----------------------------------------------------------------------------
VITE_YJS_SERVER_URL=ws://localhost:1234
YJS_PORT=1234
YJS_JWT_SECRET=replace_with_a_long_random_secret

# -----------------------------------------------------------------------------
# Optional background jobs
# -----------------------------------------------------------------------------
ENABLE_KNOWLEDGE_SCHEDULER=false
KNOWLEDGE_SCHEDULER_INTERVAL=60

# -----------------------------------------------------------------------------
# 9Router (DEV provider) — https://github.com/decolua/9router
# Local OpenAI-compatible router for development.
# -----------------------------------------------------------------------------
NINEROUTER_API_KEY=your_9router_api_key_from_dashboard
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_DEFAULT_MODEL=kr/claude-sonnet-4.5
